case "$(git var GIT_AUTHOR_IDENT)" in
  *anthropic.com*|Claude\ *)
    echo "commit-msg: 작성자가 Claude입니다. git config user.name jhlee, user.email 24471244+Jumpis@users.noreply.github.com 으로 설정하세요." >&2
    exit 1 ;;
